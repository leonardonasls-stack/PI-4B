# ==========================================
# Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# ==========================================

# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vacinacao_al
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URLs de Conexão com o Banco de Dados (Async / Sync)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vacinacao_al
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/vacinacao_al

# Autenticação e Segurança (JWT)
SECRET_KEY=superchavejwtseguraprojetointegrador2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Credenciais do Administrador Inicial / Usuários do Sistema
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@vacinaalagoas.gov.br
